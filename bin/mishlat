#!/usr/bin/env python3
"""Mishlat launcher, installed to ~/.local/bin/mishlat by install.sh."""

import os
import sys

LIB = os.environ.get("MISHLAT_LIB") or os.path.join(os.path.expanduser("~"), ".local", "share", "mishlat", "lib")
sys.path.insert(0, LIB)

from mishlat.cli import main  # noqa: E402

sys.exit(main(sys.argv))
